+// Names of the lore and of places a bot should not carry.
+bool Taken(std::string const& surname)
+{
+    static std::unordered_set<std::string> const lore = { "Bladefist", "Shadowsong", "Whisperwind", "Ironforge",
+        "Stormwind", "Goldshire", "Thunderbrew", "Bloodhoof", "Grimtotem", "Bloodscalp", "Thunderhorn", "Skyhorn",
+        "Stonehoof", "Silvermoon", "Moonglade", "Ravencrest" };
+    return lore.count(surname) != 0;
+}
+
+std::string SurnameFor(std::string const& first, uint8 race)
+{
+    uint32 h = 2166136261u;
+    for (unsigned char c : first)
+        h = (h ^ static_cast<uint32>(std::tolower(c))) * 16777619u;
+    Family const& family = FamilyFor(race);
+    size_t const a = family.first.size(), b = family.second.size(), all = a * b;
+    for (size_t k = 0; k < all; ++k)
+    {
+        size_t const i = (h + k * 7919) % all;
+        std::string surname = std::string(family.first[i % a]) + family.second[i / a];
+        if (surname.size() <= 12 && !Taken(surname))
+            return surname;
+    }
+    return std::string();
+}
