+// Names of the lore and of places a bot should not carry.
+bool Taken(std::string const& surname)
+{
+    static std::unordered_set<std::string> const lore = { "Bladefist", "Shadowsong", "Whisperwind", "Ironforge",
+        "Stormwind", "Goldshire", "Thunderbrew", "Bloodhoof", "Grimtotem", "Bloodscalp", "Thunderhorn", "Skyhorn",
+        "Stonehoof", "Silvermoon", "Moonglade", "Ravencrest" };
+    return lore.count(surname) != 0;
+}
 
